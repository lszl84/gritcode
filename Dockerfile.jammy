# Build gritcode headless against Ubuntu 22.04 (glibc 2.35) so the resulting
# binary runs inside the official SWE-bench eval images (also Ubuntu 22.04).
#
#   docker build -f Dockerfile.jammy -t gritcode-build .
#
# Note: g++-13 is needed because src/format_u8.h uses C++20 std::format, which
# libstdc++ only provides from GCC 13 onward; jammy ships GCC 11.
FROM ubuntu:22.04

RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        software-properties-common gpg-agent dirmngr \
        git ca-certificates curl \
        build-essential clang ninja-build pkg-config \
        python3 python3-pip \
        libgtk-3-dev libcurl4-openssl-dev libsqlite3-dev libsecret-1-dev \
     && add-apt-repository -y ppa:ubuntu-toolchain-r/test \
     && apt-get update \
     && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends g++-13 \
     && pip3 install --no-cache-dir cmake \
     && rm -rf /var/lib/apt/lists/*

WORKDIR /src
COPY . .

# No system wxWidgets is installed, so CMakeLists falls back to FetchContent
# and builds wxWidgets 3.2.8 (static) + tree-sitter + grammars + nlohmann/json.
# Compile with g++-13: it ships C++20 <format> (used by src/format_u8.h), which
# jammy's default g++-11/clang-14 lack. Overrides the preset's clang choice.
RUN cmake --preset release \
        -DCMAKE_C_COMPILER=gcc-13 \
        -DCMAKE_CXX_COMPILER=g++-13 \
 && cmake --build --preset release --parallel "$(nproc)"
