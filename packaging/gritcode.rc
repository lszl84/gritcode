// Windows resource file: embeds the application icon into gritcode.exe and
// pulls in wxWidgets' standard resources (cursors, window menu). The app
// manifest (DPI awareness) is a separate gritcode.manifest source: with
// MSVC's rc.exe, embedding a manifest in the .rc collides with the linker's
// own manifest resource (CVT1100 duplicate resource, LNK1123).
//
// The .ico is resolved relative to this file; CMake passes
// packaging/ to the resource compiler as an include directory.
#include <wx/msw/wx.rc>

IDI_GRITCODE_ICON ICON "gritcode.ico"
